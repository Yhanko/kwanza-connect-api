# ==========================================
# 🔑 Segurança & Ambiente
# ==========================================
SECRET_KEY=sua-chave-secreta-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.seudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://seudominio.com
SITE_URL=http://localhost:8000
ADMIN_SECRET=sua-chave-admin-secreta

# ==========================================
# 🗄️ Base de Dados (PostgreSQL)
# ==========================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kwanza_connect
DB_NAME=kwanza_connect
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ==========================================
# 🧠 Cache & Message Broker (Redis)
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# 🔐 JWT (Token Lifetimes)
# ==========================================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ==========================================
# 📧 Email (Terminal ou SMTP)
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=KwanzaConnect <noreply@kwanzaconnect.ao>

# ==========================================
# 💹 API de Taxas de Câmbio & Geolocalização
# ==========================================
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_TIMEOUT=15
GEOLOCATION_TIMEOUT=15

# ==========================================
# ☁️ Cloudinary (Upload e Mídia)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# 🛠️ Administrador Inicial (Docker Entrypoint)
# ==========================================
DJANGO_SUPERUSER_EMAIL=admin@admin.com
DJANGO_SUPERUSER_PASSWORD=adminpassword
